# Required for agent workflow and baseline LLM calls
OPENAI_API_KEY=sk-your-key-here

# Model used by baseline and agents (gpt-4o-mini recommended for eval cost)
ANTENNAPROOF_MODEL=gpt-4o-mini

# Set to 1 to skip LLM calls and use deterministic pipeline only (structure tests)
ANTENNAPROOF_DETERMINISTIC=0
